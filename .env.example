# ============================================================================
# High-Speed E-Commerce & Payment Verification Bridge (.env.example)
# Copy to .env for local development: cp .env.example .env
# NEVER commit real production credentials or secrets to version control.
# ============================================================================

# Application Environment (development | test | production)
NODE_ENV=development
PORT=5000

# PostgreSQL Configuration (development-only example credentials)
POSTGRES_USER=fashion_dev
POSTGRES_PASSWORD=dev_only_change_in_prod_987654
POSTGRES_DB=fashion_store_db
DATABASE_URL=postgres://fashion_dev:dev_only_change_in_prod_987654@localhost:5432/fashion_store_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# CORS & Frontend Configuration
FRONTEND_ORIGIN=http://localhost:3000
# Leave empty to use relative /api routes via Next.js proxy/API handlers
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://127.0.0.1:5000

# Admin Authentication Token (minimum 16 characters required)
ADMIN_TOKEN=dev_admin_token_replace_me_123456

# Payment Mode: "mock" (development/sandbox only; blocked in production) | "razorpay"
PAYMENT_MODE=mock
ORDER_EXPIRY_MINUTES=4

# Razorpay Credentials (required when PAYMENT_MODE=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Telegram Admin Notification Bot Token (optional in dev; set in production)
TELEGRAM_BOT_TOKEN=
