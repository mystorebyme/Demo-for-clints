<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="600" height="600" role="img" aria-label="Structured Everyday Tote Handbag">
  <defs>
    <linearGradient id="bg-bag3" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#bg-bag3)"/>
  <circle cx="300" cy="285" r="210" fill="#ffffff" opacity="0.65"/>
  <!-- Demo Merchandise Transparency Badge -->
  <rect x="24" y="24" width="180" height="32" rx="16" fill="#1f2937" opacity="0.82"/>
  <text x="114" y="45" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#ffffff" letter-spacing="0.8">DEMO CATALOG ITEM</text>
  
  
      <g >
        <!-- Dual Handles -->
        <path d="M240 215 Q240 120 272 120 Q300 120 300 215" fill="none" stroke="#334155" stroke-width="10"/>
        <path d="M300 215 Q300 120 328 120 Q360 120 360 215" fill="none" stroke="#334155" stroke-width="10"/>
        <!-- Structured Tote Body -->
        <path d="M180 210 L420 210 L398 415 L202 415 Z" fill="#334155" stroke="#475569" stroke-width="4"/>
        <line x1="205" y1="245" x2="395" y2="245" stroke="#f59e0b" stroke-width="3"/>
        <rect x="275" y="265" width="50" height="24" rx="5" fill="#f59e0b"/>
      </g>
    
  <!-- Bottom Caption Card -->
  <rect x="40" y="492" width="520" height="80" rx="16" fill="#ffffff" opacity="0.92"/>
  <text x="300" y="526" text-anchor="middle" font-family="system-ui, sans-serif" font-size="20" font-weight="700" fill="#111827">Structured Everyday Tote Handbag</text>
  <text x="300" y="553" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" font-weight="500" fill="#6b7280">Spacious Zippered Laptop & Work Tote</text>
</svg>